# ===================================================================
# PayPulse Platform - Configuration Template
# Copy this file to application.properties and fill in your credentials
# ===================================================================

spring.application.name=paypulse-backend

# -------------------------------------------------------------------
# Database Configuration (MySQL)
# -------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/ems?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=your_mysql_password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# -------------------------------------------------------------------
# Containerized Infrastructure (Docker Desktop)
# Run `docker compose up -d` to launch Redis & Kafka
# -------------------------------------------------------------------
# Redis In-Memory Cache (Idempotency & Distributed Locks)
spring.data.redis.host=localhost
spring.data.redis.port=6379

# Apache Kafka Event Streaming (KRaft Mode)
spring.kafka.bootstrap-servers=localhost:9092
spring.kafka.consumer.group-id=paypulse-core-group
spring.kafka.consumer.auto-offset-reset=earliest

# -------------------------------------------------------------------
# JWT Security & Bank-Grade Token Management
# -------------------------------------------------------------------
app.jwt-secret=9a6747f3a1824ed673b504432d4ae8b378729f8497d511d730a2ace3213b8f6e
app.jwt-expiration-milliseconds=900000
app.jwt-refresh-expiration-days=7

# -------------------------------------------------------------------
# Two-Factor Authentication (2FA Email OTP via SMTP)
# -------------------------------------------------------------------
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your_email@gmail.com
spring.mail.password=your_gmail_app_password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# -------------------------------------------------------------------
# Spring Boot Actuator & Observability Metrics
# -------------------------------------------------------------------
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=always
